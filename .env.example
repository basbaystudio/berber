# PostgreSQL (yerel: docker compose up -d | canlı: Neon pooled connection string)
DATABASE_URL=postgres://berber:berber@localhost:5432/berber
# Testler için ayrı veritabanı (testler her çalıştırmada sıfırlar!)
TEST_DATABASE_URL=postgres://berber:berber@localhost:5432/berber_test

# Uygulamanın genel adresi (e-posta bağlantıları vb.)
APP_URL=http://localhost:3000

# İlk platform yöneticisi (npm run admin:create)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Günlük zamanlanmış görevi korur (Vercel otomatik olarak "Authorization: Bearer <CRON_SECRET>" gönderir)
CRON_SECRET=
# E-posta (Resend ücretsiz katman). Boşsa e-postalar yalnızca log'a yazılır.
RESEND_API_KEY=
EMAIL_FROM="Dijital Berber <bildirim@dijitalberber.com>"
# Görsel depolama (Vercel Blob). Boşsa yerelde .uploads klasörü kullanılır.
BLOB_READ_WRITE_TOKEN=

# İşletme bulma aracı (npm run isletme:bul). Kurulum: docs/ISLETME-BULMA.md
GOOGLE_PLACES_API_KEY=
